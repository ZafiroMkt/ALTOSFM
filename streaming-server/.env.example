# Copia este archivo como .env y cambia las contraseñas.
#   cp .env.example .env

# Dominio público del stream (debe apuntar con un registro A a la IP del servidor)
STREAM_DOMAIN=stream.altosfm.com
ICECAST_HOSTNAME=stream.altosfm.com

# Punto de montaje: la URL final será https://STREAM_DOMAIN/radio
ICECAST_MOUNT=/radio

# Contraseña que pones en BUTT / OBS / Mixxx para transmitir (usuario: source)
ICECAST_SOURCE_PASSWORD=cambia-esta-clave-de-transmision

# Contraseña del panel de administración (usuario: admin)
ICECAST_ADMIN_PASSWORD=cambia-esta-clave-de-admin

# Máximo de oyentes simultáneos
ICECAST_MAX_CLIENTS=500

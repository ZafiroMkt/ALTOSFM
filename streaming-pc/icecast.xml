<!--
  Configuración de Icecast para la PC del estudio (Windows) - Altos FM
  Copia este archivo encima de:  C:\Program Files\Icecast\icecast.xml
  (o la carpeta donde se instaló Icecast) y CAMBIA LAS DOS CONTRASEÑAS.
-->
<icecast>
    <location>Altos Mirandinos, Venezuela</location>
    <admin>contacto@altosfm.com</admin>
    <hostname>stream.altosfm.com</hostname>

    <limits>
        <clients>100</clients>
        <sources>2</sources>
        <queue-size>524288</queue-size>
        <client-timeout>30</client-timeout>
        <header-timeout>15</header-timeout>
        <source-timeout>10</source-timeout>
        <burst-on-connect>1</burst-on-connect>
        <burst-size>65535</burst-size>
    </limits>

    <authentication>
        <!-- Clave que pones en RocketBroadcaster (usuario: source) -->
        <source-password>CAMBIA-ESTA-CLAVE-DE-TRANSMISION</source-password>
        <relay-password>CAMBIA-ESTA-CLAVE-DE-ADMIN</relay-password>
        <!-- Clave del panel http://localhost:8000/admin/ (usuario: admin) -->
        <admin-user>admin</admin-user>
        <admin-password>CAMBIA-ESTA-CLAVE-DE-ADMIN</admin-password>
    </authentication>

    <!-- Solo escucha dentro de la PC; el público entra por Cloudflare Tunnel -->
    <listen-socket>
        <port>8000</port>
        <bind-address>127.0.0.1</bind-address>
    </listen-socket>

    <!-- Permite que la página web (altosfm.com) lea el audio y la metadata -->
    <http-headers>
        <header name="Access-Control-Allow-Origin" value="*" />
        <header name="Access-Control-Allow-Headers" value="Origin, Accept, X-Requested-With, Content-Type, Icy-MetaData" />
        <header name="Access-Control-Allow-Methods" value="GET, OPTIONS, HEAD" />
    </http-headers>

    <mount type="normal">
        <mount-name>/radio</mount-name>
        <stream-name>Altos FM</stream-name>
        <stream-description>La señal de los Altos Mirandinos</stream-description>
        <stream-url>https://altosfm.com</stream-url>
        <genre>Variado</genre>
        <public>0</public>
        <!-- Para que los acentos y la ñ se vean bien en el nombre de la canción -->
        <charset>UTF-8</charset>
    </mount>

    <fileserve>1</fileserve>

    <paths>
        <logdir>./logs</logdir>
        <webroot>./web</webroot>
        <adminroot>./admin</adminroot>
        <alias source="/" destination="/status.xsl"/>
    </paths>

    <logging>
        <accesslog>access.log</accesslog>
        <errorlog>error.log</errorlog>
        <loglevel>3</loglevel>
        <logsize>10000</logsize>
    </logging>
</icecast>
